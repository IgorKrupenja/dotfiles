<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs scripts/update.sh daily at 12:30, half an hour before the backup so the two don't run at once,
     or on wake if the Mac was asleep then. Installed by install/install.sh. To run it now:
     launchctl kickstart gui/$(id -u)/com.igorkrupenja.dotfiles.update -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.igorkrupenja.dotfiles.update</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/igor/Projects/dotfiles/scripts/update.sh</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>12</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/igor/Library/Logs/update.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/igor/Library/Logs/update.log</string>
</dict>
</plist>
