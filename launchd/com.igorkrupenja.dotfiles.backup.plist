<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs scripts/backup.sh daily at 13:00, or on wake if the Mac was asleep then. Installed by
     install/install.sh. To run it now: launchctl kickstart gui/$(id -u)/com.igorkrupenja.dotfiles.backup -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.igorkrupenja.dotfiles.backup</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/igor/Projects/dotfiles/scripts/backup.sh</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>13</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/igor/Library/Logs/backup.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/igor/Library/Logs/backup.log</string>
</dict>
</plist>
