<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs scripts/backup.sh daily at 13:00, or on wake if the Mac was asleep then. Installed by
     install/install.sh in each macOS account. To run it now:
     launchctl kickstart gui/$(id -u)/com.igorkrupenja.dotfiles.backup

     The script is passed to /bin/bash rather than run directly: macOS repeats its "can run in the
     background" notification whenever an agent's unsigned program changes, so every edit of
     backup.sh brought it back. Apple-signed bash doesn't trigger it. Its paths and the log's go
     through $HOME, so that each account runs its own clone of this repo. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.igorkrupenja.dotfiles.backup</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-c</string>
		<string>exec /bin/bash "$HOME/Projects/dotfiles/scripts/backup.sh" &gt;&gt; "$HOME/Library/Logs/backup.log" 2&gt;&amp;1</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>13</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
</dict>
</plist>
