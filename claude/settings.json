{
  "env": {
    "CLAUDE_CODE_EFFORT_LEVEL": "max"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit(*)",
      "Write(*)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "WebFetch(*)",
      "WebSearch",
      "mcp__mcp-google-sheets__create_spreadsheet",
      "mcp__mcp-google-sheets__update_cells",
      "mcp__mcp-google-sheets__batch_update",
      "mcp__mcp-google-sheets__batch_update_cells",
      "mcp__mcp-google-sheets__list_sheets",
      "mcp__mcp-google-sheets__get_sheet_data",
      "mcp__claude_ai_Linear__list_comments",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_wait_for",
      "mcp__claude_ai_Linear__list_teams",
      "mcp__claude_ai_Linear__create_attachment",
      "mcp__playwright__browser_network_requests",
      "mcp__playwright__browser_evaluate",
      "mcp__mcp-google-sheets__search_spreadsheets",
      "mcp__claude_ai_Linear__list_issues",
      "mcp__claude_ai_Notion__notion-fetch",
      "mcp__claude_ai_Notion__notion-search",
      "mcp__claude_ai_Linear__save_issue",
      "mcp__claude_ai_Linear__get_issue",
      "mcp__claude_ai_Linear__save_comment",
      "mcp__claude_ai_Linear__save_project",
      "mcp__claude_ai_Linear__list_projects",
      "mcp__claude_ai_Linear__delete_comment",
      "mcp__claude_ai_Linear__create_issue_label",
      "Edit(~/.claude/skills/estonia-events-crawl/**)",
      "Edit(~/.claude/skills/estonia-events-add/**)",
      "Edit(~/.claude/skills/estonia-events-coda/**)",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_fill_form",
      "mcp__playwright__browser_type",
      "mcp__playwright__browser_console_messages",
      "mcp__playwright__browser_resize",
      "mcp__playwright__browser_close",
      "mcp__figma__get_screenshot",
      "mcp__figma__get_metadata",
      "Bash(mv /Users/igor/.claude/tallinn-dev-skills ~/Projects/tallinn-dev)",
      "Read(//Users/igor/Projects/**)"
    ],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "/Users/igor/.claude/projects/-Users-igor-Projects-liqd-player-frontend/memory",
      "/Users/igor/.claude/skills",
      "/Users/igor/.claude/skills/estonia-events-crawl",
      "/Users/igor/.claude"
    ]
  },
  "model": "opus[1m]",
  "enabledPlugins": {
    "figma@claude-plugins-official": false,
    "autofix-relay@autofix-relay": true,
    "session-banners@igor-plugins": true,
    "status-bar@igor-plugins": true,
    "worktree-warmup@igor-plugins": true
  },
  "extraKnownMarketplaces": {
    "autofix-relay": {
      "source": {
        "source": "directory",
        "path": "/Users/igor/.claude/local-plugins/autofix-relay"
      }
    },
    "igor-plugins": {
      "source": {
        "source": "directory",
        "path": "/Users/igor/Projects/claude-notify"
      }
    }
  },
  "outputStyle": "Concise",
  "pluginConfigs": {
    "status-bar@igor-plugins": {
      "options": {
        "workspace": "liqdcom",
        "stages": "main=dev, qa=qa, prod=prod",
        "previewWorkflow": "pr-preview.yml",
        "previewLinks": "Preview=https://pr-{number}.preview.dev.liqd.com, Admin=https://pr-{number}.admin.preview.dev.liqd.com"
      }
    },
    "worktree-warmup@igor-plugins": {
      "options": {
        "command": "pnpm install --frozen-lockfile && pnpm run media:manifest"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "light-ansi",
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Uploading pull request screenshots (PNG images of app UI) to the user's own secret GitHub gist, by gh gist create or by cloning the gist over https and git push to it, so they can be embedded in a pull request body: the user built this flow for PR screenshots and pre-approves every such upload"
    ]
  }
}
